      RAVEN2: EMBEDDED TEXT + GENERATE  9
      DEFINE REGIONS                    2 A0            2
      LIST REGION                       2 L0            100
      TOKEN REGION                      2 T0            20
      GENERATOR STEP REGION             2 G0            2
      ROUTINE HEADER. TYPE=5,Q=0.       5       00
      MAIN: W0 = START WORD T1            A0    10T1
                                                20W0
      PRINT START WORD                          11W0
                                                  J152
      PRINT EMBEDDED TEXT LIST T9               10T9
                                                  J151
      STEP                                        G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
                                                  G1
      QUIT                                        J7    0
      ROUTINE HEADER. TYPE=5,Q=0.       5       00
      G1: ONE GENERATION STEP             G1    11W0
      PUSH CURRENT WORD TWICE                   11W0
      N = COUNT OF ITS LIST                       J126
      R = RANDOM 0..N-1                           J129
      R+1                                         J125
      CELL = R+1 TH SYMBOL                        J200
      NEXT WORD = SYMB OF CELL                    J80 
      W0 = NEXT WORD                            20W0
      PRINT IT                                  11W0
                                                  J152  0
      DATA HEADER. TYPE=5,Q=1.          5       01
      SUCCESSORS OF T1                    T1      0
                                                  T2
                                                  T2
                                                  T3    0
      SUCCESSORS OF T2                    T2      0
                                                  T3
                                                  T1    0
      SUCCESSORS OF T3                    T3      0
                                                  T1
                                                  T2    0
      EMBEDDED TEXT (TOKEN STREAM)        T9      0
                                                  T1
                                                  T2
                                                  T3
                                                  T1
                                                  T3
                                                  T2
                                                  T1
                                                  T2    0
      START AT A0                       5         A0
