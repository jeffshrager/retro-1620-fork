      RAVEN5A: PRINT ALNUM DATA TERM    9
      DEFINE REGIONS                    2 A0            2
      LIST REGION                       2 L0            200
      TOKEN REGION                      2 T0            40
      WORD-TERM REGION                  2 V0            40
      KEY REGION                        2 K0            2
      ROUTINE HEADER. TYPE=5,Q=0.       5       00
      PRINT V1 DIRECTLY                   A0    10V1
                                                  J152
      T1[K1] = V1                               10T1
                                                10V1
                                                10K1
                                                  J11
      FIND T1[K1], PRINT                        10T1
                                                10K1
                                                  J10
                                                  J152
      PRINT V2 (LONGER CHUNK?)                  10V2
                                                  J152
                                                  J7    0
      DATA HEADER. TYPE=5,Q=1.          5       01
                                          V1    21ONCE
                                          V2    21PONDE
                                          T1      0     0
      START AT A0                       5         A0
