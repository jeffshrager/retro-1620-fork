                                          V14   21QUAI
                                          V15   21CURI
                                          V16   21VOLU
                                          V17   21OF
                                          V18   21FORG
                                          V19   21LORE
      LIST T37 = TEXT TERMS, LIST T38 = 1
      WORD SYMBOLS, IN THE SAME ORDER.  1
      TEXT-TERM LIST                      T37     0
