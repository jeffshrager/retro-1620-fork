      READ CARD PROBE (J180)            9
      DEFINE REGIONS                    2 A0            2
      LIST REGION                       2 L0            10
      X REGION                          2 X0            10
      PRINT LINE X1, 80 CHARS           3 X1    01        80
      ROUTINE HEADER. TYPE=5,Q=0.       5       00
      START A0 SET UP LINE X1             A0    10X1
      READ A CARD INTO X1                         J180
      PRINT LINE X1                             10X1
                                                  J155  0
      DATA HEADER. TYPE=5,Q=1.          5       01
      START AT A0                       5         A0
