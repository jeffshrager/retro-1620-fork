// Call graph of the standard IPL-V J subroutines in subroutines.ipl.
// Edge A -> B: routine A has B in a SYMB or LINK field. Left = loaded routines
// not called by any other routine here; right = J functions not defined in the
// deck, i.e. hard coded in the interpreter. J2n/J3n/J4n/J5n/J8n/J9n are the
// families of n-routines (J20-29, ..., J90-99; both loaded and hard-coded members).
digraph IPLV_J {
  rankdir=LR; nodesep=0.15; ranksep=1.1; splines=true;
  node [shape=box, fontname="Helvetica", fontsize=11, style=filled];
  edge [color="#666666", arrowsize=0.6];
