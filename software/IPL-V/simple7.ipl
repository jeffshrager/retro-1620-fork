      SIMPLE TEST FOR IPL-V             9
      DEFINE REGIONS                    2 A0            5
                                        5       00
      GET SYMB A3                         A0    10A3
      INCREMENT IT                              00J125
      INPUT A3 = RESULT (FRESH)                 10A3
      PRINT RESULT, QUIT.                         J152  0
                                        1
                                        5       01
      CONSTANT 3                          A3    01      3
      START AT A0                       5         A0
